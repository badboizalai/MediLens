{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENV": "local"
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python3 tools/*)",
      "Bash(uv run:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./data/raw/**)",
      "Read(./data/private/**)",
      "Read(./ml/datasets/real/**)",
      "Read(./imaging/dicom-real/**)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@mattpocock": true,
    "taste-skill@taste-skill": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "leonxlnx/taste-skill"
      }
    }
  }
}
