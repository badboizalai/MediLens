# Copy to .env — never commit .env. Values below are LOCAL DEV ONLY (no real data).
ENV=local
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=medilens
POSTGRES_PASSWORD=medilens_dev
POSTGRES_DB=medilens
DATABASE_URL=postgresql+psycopg://medilens:medilens_dev@localhost:5432/medilens

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, S3 in cloud)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=medilens-documents

# Auth (Keycloak OIDC)
OIDC_ISSUER=http://localhost:8080/realms/medilens
OIDC_AUDIENCE=medilens-api

# AI Gateway (providers are called only through the gateway, after PII redaction)
AI_GATEWAY_URL=http://localhost:8100
LLM_PROVIDER=stub          # stub | bedrock | anthropic
ANTHROPIC_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
