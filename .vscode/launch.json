{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["medilens.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "medilens_worker.main",
      "cwd": "${workspaceFolder}/apps/worker",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
