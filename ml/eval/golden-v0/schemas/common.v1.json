{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medilens.local/schemas/common.v1.json",
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "quote"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "quote": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "StringField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "NumberField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "DateField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "confidence": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/DateField"
        },
        "facility": {
          "$ref": "#/$defs/StringField"
        },
        "department": {
          "$ref": "#/$defs/StringField"
        }
      }
    }
  }
}
