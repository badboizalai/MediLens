{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medilens.local/schemas/common.v1.json",
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "quote"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "description": "Normalised box [x0,y0,x1,y1] in 0..1 of the page, origin top-left. Optional: absent when the OCR engine gives no layout.",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "quote": {
          "type": "string",
          "maxLength": 300,
          "description": "Exact text cited from the page."
        }
      }
    },
    "StringField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "NumberField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "DateField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      }
    },
    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/DateField"
        },
        "facility": {
          "$ref": "#/$defs/StringField"
        },
        "department": {
          "$ref": "#/$defs/StringField"
        }
      }
    },
    "Region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_code",
        "confidence"
      ],
      "description": "Anatomical region from the Unit region tree (contract with assets and viewer). region_code null = unmapped.",
      "properties": {
        "region_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
