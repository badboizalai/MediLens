{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medilens.local/schemas/unit-config.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_code", "version", "name_vi", "name_en", "extraction_schema", "regions", "visual_rules"],
  "properties": {
    "unit_code": { "enum": ["dental", "cardiology", "oncology"] },
    "version": { "type": "integer", "minimum": 1 },
    "name_vi": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string", "minLength": 1 },
    "extraction_schema": { "type": "string", "pattern": "^ml/schemas/[a-z]+\\.v[0-9]+\\.json$" },
    "regions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "loinc", "unit", "region"],
        "properties": {
          "key": { "type": "string" },
          "loinc": { "type": "string", "pattern": "^[0-9]{1,5}-[0-9]$" },
          "unit": { "enum": ["%", "mm[Hg]", null] },
          "region": { "type": "string" }
        }
      }
    },
    "visual_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity_palette", "patient_reported", "default_region_state"],
      "properties": {
        "severity_palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["monitor", "mild", "moderate", "severe"],
          "patternProperties": { "^(monitor|mild|moderate|severe)$": { "$ref": "#/$defs/token" } }
        },
        "patient_reported": { "$ref": "#/$defs/token" },
        "default_region_state": { "$ref": "#/$defs/token" }
      }
    }
  },
  "$defs": { "token": { "type": "string", "pattern": "^severity\\.(monitor|mild|moderate|severe|spread|reference)$" } }
}
